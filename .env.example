# ============================================================
# KrishiMitra-AI — Root Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# ============================================================

# -- Database --
MONGODB_URI=mongodb://localhost:27017/krishimitraai

# -- Neo4j Graph Database --
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# IMPORTANT: Change this to a strong unique password before deploying
NEO4J_PASSWORD=change_me_before_deploy

# -- ML / FastAPI Service --
ML_SERVICE_URL=http://127.0.0.1:8000

# -- LLM Backends --
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest

# Gemini API (fallback LLM)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Primary LLM backend: 'gemini' or 'ollama'
LLM_PRIMARY=gemini

# -- Express Backend --
PORT=5000
JWT_SECRET=replace_with_a_long_random_string_at_least_64_chars

# -- CORS --
# Comma-separated list of allowed frontend origins (backend + ml-service both read this)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:8081,http://localhost:5173,http://127.0.0.1:8081,http://127.0.0.1:3000

# -- Demo / Development Mode --
# Set DEMO_MODE=true ONLY for local development. NEVER in staging/production.
DEMO_MODE=false
# DEMO_TOKEN: bearer token that bypasses JWT when DEMO_MODE=true
DEMO_TOKEN=replace_with_a_long_random_demo_token
# DEMO_OTP: 6-digit OTP bypass value when DEMO_MODE=true
DEMO_OTP=000000

# -- Third-Party APIs --
AGMARKNET_API_KEY=your_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# -- Misc --
NODE_ENV=development
FRONTEND_URL=http://localhost:3000