PORT=8000
MONGODB_URI=mongodb://localhost:27017/krishimitraai

# -- Neo4j Graph Database --
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# IMPORTANT: Change this to a strong unique password before deploying
NEO4J_PASSWORD=change_me_before_deploy

# -- LLM Backends --
OLLAMA_MODEL=llama3.1:8b
OLLAMA_VISION_MODEL=llava:7b
OLLAMA_BASE_URL=http://localhost:11434

# Gemini Fallback (Required if Ollama is unavailable)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Primary LLM backend: 'gemini' (cloud) or 'ollama' (local/offline)
LLM_PRIMARY=gemini

# -- CORS --
# Comma-separated list of allowed origins.
# Default covers standard local dev ports for frontend and backend.
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:8081,http://127.0.0.1:5000,http://127.0.0.1:8081,http://localhost:5173,http://localhost:19006

# -- Embeddings & Knowledge Base --
HUGGINGFACE_EMBEDDING_MODEL=all-MiniLM-L6-v2

# -- Voice Transcription --
# Supported values: tiny, base, small, medium, large
# 'base' is fastest offline; 'small' or 'medium' recommended for Indian language accuracy
WHISPER_MODEL=base

# -- AgriPerplexity Web Search --
TAVILY_API_KEY=your_tavily_api_key_here